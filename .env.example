# ── Database (MySQL/MariaDB dari hPanel → Databases → MySQL) ──────────
# Format: mysql://USER:PASSWORD@HOST:3306/NAMA_DB  (pastikan charset utf8mb4)
DATABASE_URL="mysql://u123_zude:PASSWORD@localhost:3306/u123_zude"

# ── Auth ─────────────────────────────────────────────────────────────
# Rahasia penanda sesi, minimal 32 karakter acak:  openssl rand -base64 48
AUTH_SECRET=""
# Token untuk halaman /setup (membuat 2 pengguna pertama). Hapus/ganti setelah setup.
SETUP_TOKEN=""

# ── URL publik (dipakai di email) ────────────────────────────────────
APP_URL="https://zude.example.com"

# ── Cron Jobs hPanel ─────────────────────────────────────────────────
# Header: x-cron-secret: <CRON_SECRET>   (openssl rand -hex 32)
CRON_SECRET=""

# ── Web Push (VAPID) ─────────────────────────────────────────────────
# Generate:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ── Email (SMTP email Hostinger) — opsional ──────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ZuDe <noreply@example.com>"

# ── Backup ───────────────────────────────────────────────────────────
# Folder backup harian (default ./backups). Di hPanel pilih folder di luar public_html.
BACKUP_DIR=""
