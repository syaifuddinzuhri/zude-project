# ── Database (MySQL/MariaDB dari hPanel → Databases → MySQL) ──────────
# Format: mysql://USER:PASSWORD@HOST:3306/NAMA_DB
# Di Vercel: HOST = IP/host server MySQL Niagahoster (Remote MySQL dibuka), tambahkan pool kecil:
#   ?connection_limit=3&pool_timeout=20
DATABASE_URL="mysql://u123_zude:PASSWORD@HOST_MYSQL_NIAGAHOSTER:3306/u123_zude?connection_limit=3&pool_timeout=20"

# ── Auth ─────────────────────────────────────────────────────────────
# Rahasia penanda sesi, minimal 32 karakter acak:  openssl rand -base64 48
AUTH_SECRET=""
# PIN awal untuk masuk (4–6 angka). Setelah masuk, ganti PIN di Pengaturan → Keamanan;
# PIN dari env ini hanya dipakai selama PIN belum pernah diganti.
APP_PIN=""
# PIN khusus untuk "Reset semua data" (Pengaturan → Keamanan → Zona bahaya), 4–12 angka.
# Kosongkan untuk menonaktifkan fitur reset. Jangan samakan dengan APP_PIN.
RESET_PIN=""

# ── URL publik (dipakai di email) ────────────────────────────────────
APP_URL="https://zude.example.com"

# ── Cron Jobs hPanel ─────────────────────────────────────────────────
# Header: x-cron-secret: <CRON_SECRET>  atau  Authorization: Bearer <CRON_SECRET> (cron Vercel)
# Generate: openssl rand -hex 32
CRON_SECRET=""

# ── Web Push (VAPID) ─────────────────────────────────────────────────
# Generate:  npx web-push generate-vapid-keys
# VAPID_SUBJECT wajib email asli (mailto:nama@domain.com) atau URL https aplikasi.
# Jangan pakai @localhost: push ke iPhone/Safari ditolak Apple (403 BadJwtToken).
# Bila kosong/localhost, APP_URL dipakai otomatis.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ── Email (SMTP email Hostinger) — opsional ──────────────────────────
# Penerima email pengingat (pisahkan dengan koma)
NOTIFY_EMAIL=""
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ZuDe <noreply@example.com>"

# ── Backup ───────────────────────────────────────────────────────────
# Folder backup harian (default ./backups) — hanya untuk server dengan disk (bukan Vercel).
# Di Vercel backup dikirim lewat email ke NOTIFY_EMAIL.
BACKUP_DIR=""
