{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "prisma migrate deploy && npm run build",
  "crons": [
    { "path": "/api/cron/recurring", "schedule": "10 17 * * *" },
    { "path": "/api/cron/backup", "schedule": "0 19 * * *" }
  ]
}
